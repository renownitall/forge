# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
_pkgname=lilac
pkgname=lilac-git
pkgver=0.0.1.r21.gb318cfb
pkgrel=1
pkgdesc="Modern Qt6 application style based on the Orchis GTK theme (git)"
arch=('x86_64')
url="https://github.com/zalesyc/lilac"
license=('GPL-3.0-or-later')
provides=('lilac')
conflicts=('lilac')
depends=(
  'qt6-base'
  'kconfig'
  'kwindowsystem'
  'qt6-declarative'
)
makedepends=(
  'cmake'
  'git'
)
options=(!debug)
source=(
  "$_pkgname::git+$url.git"
  'checkbox-radius.patch'
  'lilacrc'
)
sha256sums=(
  'SKIP'
  'bdeb9c4093a279c2ecfecce1cdbdf44a60448bcb14b08faf61142de8c2c5ca38'
  '25614c27e5b2114b70c0f6f9ffa1d5861f256572e97571c14f6ef02bb87991ff'
)
backup=('etc/xdg/lilacrc')

pkgver() {
  cd "$srcdir/$_pkgname"
  git describe --long --tags --abbrev=7 2>/dev/null |
    sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "0.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$srcdir/$_pkgname"
  # Upstream ignores the CornerRadius setting for non-circle checkboxes
  # (hardcoded 6px); derive it so CornerRadius=0 is fully square.
  patch -Np1 -i "$srcdir/checkbox-radius.patch"
}

build() {
  cd "$srcdir/$_pkgname"
  # Upstream CMakeLists uses CMAKE_INSTALL_LIBDIR/DATAROOTDIR without
  # including GNUInstallDirs, so set both explicitly. KStyle targets KDE
  # Plasma (upstream recommends QCommonStyle elsewhere) and KColorScheme
  # would read KDE color-scheme files instead of the qt6ct palette, so
  # both stay off on a qt6ct-driven setup.
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_INSTALL_DATAROOTDIR=share \
    -DNO_KSTYLE=ON \
    -DNO_KCOLORSCHEME=ON
  cmake --build build --parallel
}

package() {
  cd "$srcdir/$_pkgname"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # Ship square corners by default. KConfig falls back to /etc/xdg when
  # the user has no ~/.config/lilacrc, so this stays overridable via
  # the lilacsettings app (takes effect for newly started apps).
  install -Dm644 "$srcdir/lilacrc" "$pkgdir/etc/xdg/lilacrc"
}
