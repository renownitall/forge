# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
_pkgname=swayfx
pkgname=$_pkgname-git
pkgver=r7135.8775477
pkgrel=1
pkgdesc="Sway compositor with shadows, blur, and rounded corners, built against wlroots 0.20 (git)"
arch=('x86_64')
url="https://github.com/wlrfx/swayfx"
license=('MIT')
provides=('sway' "$_pkgname" 'wayland-compositor')
conflicts=('sway' "$_pkgname")
depends=(
  'cairo'
  'gdk-pixbuf2'
  'libevdev.so=2-64'
  'libinput'
  'libjson-c.so=5-64'
  'libpixman-1.so=0-64'
  'libudev.so=1-64'
  'libwayland-server.so=0-64'
  'libxcb'
  'libxkbcommon.so=0-64'
  'pango'
  'pcre2'
  'wlroots0.20'
  'xcb-util-wm'
)
makedepends=(
  'git'
  'libdrm'
  'meson'
  'ninja'
  'scdoc'
  'wayland-protocols'
  'wlroots0.20'
  'xorg-xwayland'
)
options=(!debug)
source=(
  "$_pkgname::git+$url.git"
  "scenefx::git+https://github.com/wlrfx/scenefx.git#commit=ec7c1599d9b7b67d3772f8f3ec67ac0681d70853"
)
sha256sums=('SKIP'
  'SKIP')

pkgver() {
  cd "$srcdir/$_pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
  cd "$srcdir/$_pkgname"

  # Build scenefx from source (not packaged in official Arch repos).
  mkdir -p subprojects
  cp -a "$srcdir/scenefx" subprojects/scenefx
  meson setup build-scenefx subprojects/scenefx --prefix=/usr -Ddefault_library=static
  ninja -C build-scenefx
  DESTDIR="$PWD/install-scenefx" ninja -C build-scenefx install
  # Remove scenefx source so meson's subproject() fallback doesn't activate
  # during the swayfx build (it would pass unsupported options to scenefx).
  rm -rf subprojects build-scenefx

  # Build swayfx, finding scenefx via PKG_CONFIG_PATH and include paths.
  export PKG_CONFIG_PATH="$PWD/install-scenefx/usr/lib/pkgconfig:$PKG_CONFIG_PATH"
  export CPATH="$PWD/install-scenefx/usr/include/scenefx-0.5:$CPATH"
  export LIBRARY_PATH="$PWD/install-scenefx/usr/lib:$LIBRARY_PATH"
  meson setup build --prefix=/usr --wrap-mode=nofallback -Dman-pages=enabled -Dswaybar=true -Dswaynag=true
  ninja -C build
}

package() {
  cd "$srcdir/$_pkgname"
  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
