# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
pkgname=ttf-geist
pkgver=1.7.2
pkgrel=1
epoch=1
pkgdesc="Geist Sans geometric sans serif font by Vercel (TTF)"
arch=('any')
url="https://vercel.com/font"
license=('OFL-1.1')
depends=('fontconfig')
provides=('ttf-font')
conflicts=('ttf-geist-git')
source=("geist-font-v${pkgver}.zip::https://github.com/vercel/geist-font/releases/download/v${pkgver}/geist-font-v${pkgver}.zip")
sha256sums=('7fc800d2ac6b92844895196e5041aca55d814c15db70c44f79b3b83ab82b04e2')

package() {
  cd "$srcdir/geist-font"
  install -Dm644 Geist/ttf/*.ttf -t "$pkgdir/usr/share/fonts/TTF"
  install -Dm644 OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
