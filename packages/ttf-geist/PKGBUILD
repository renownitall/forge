# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
pkgname=ttf-geist
pkgver=1.8.0
pkgrel=1
pkgdesc="Geist Sans geometric sans serif font by Vercel (TTF)"
arch=('any')
url="https://vercel.com/font"
license=('OFL-1.1')
depends=('fontconfig')
provides=('ttf-font')
conflicts=('ttf-geist-git')
source=("geist-font-${pkgver}.zip::https://github.com/vercel/geist-font/releases/download/${pkgver}/geist-font-${pkgver}.zip")
sha256sums=('ee309b6b0762f89c3e8a799f700bee0323315ff047df3a587af978f8180daa28')

package() {
  cd "$srcdir/geist-font-${pkgver}"
  install -Dm644 fonts/Geist/ttf/*.ttf -t "$pkgdir/usr/share/fonts/TTF"
  install -Dm644 OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname"
}
