# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
pkgname=ttf-googlesans-code-nerd
pkgver=3.5.1
pkgrel=1
epoch=1
pkgdesc="Google Sans Code patched with Nerd Font icons"
arch=('any')
url="https://github.com/ryanoasis/nerd-fonts"
license=('OFL-1.1')
depends=('fontconfig')
provides=('ttf-font' 'nerd-fonts' 'ttf-google-sans-code-nerd' 'ttf-google-sans-code-nf' 'ttf-google-sans-code-nerd-font' 'ttf-googlesans-code-nerd-mono' 'ttf-googlesans-code-nerd-propo')
conflicts=('ttf-google-sans-code-nerd' 'ttf-google-sans-code-nf' 'ttf-google-sans-code-nerd-font' 'ttf-googlesans-code-nerd-git')
source=("GoogleSansCode-${pkgver}.zip::https://github.com/ryanoasis/nerd-fonts/releases/download/v${pkgver}/GoogleSansCode.zip")
sha256sums=('b09b9a0410fe95d3720c48aa51bb34304af19a0a06cacefab042d2cc709e1a76')

package() {
  cd "$srcdir"
  install -Dm644 *.ttf -t "$pkgdir/usr/share/fonts/TTF/"
  install -Dm644 OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
