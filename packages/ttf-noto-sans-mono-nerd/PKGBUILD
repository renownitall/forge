# Maintainer: Akira Meisei <64113367+renownitall@users.noreply.github.com>
pkgname=ttf-noto-sans-mono-nerd
pkgver=3.5.1
pkgrel=1
pkgdesc="Noto Sans Mono patched with Nerd Fonts in all weights, with NF, Mono, and Propo variants"
arch=('any')
url="https://github.com/ryanoasis/nerd-fonts"
license=('OFL-1.1')
depends=('fontconfig')
provides=('ttf-font' 'nerd-fonts' 'ttf-noto-sans-mono-nerd' 'ttf-noto-sans-mono-nf')
conflicts=('ttf-noto-sans-mono-nerd-git')
source=("Noto-${pkgver}.zip::https://github.com/ryanoasis/nerd-fonts/releases/download/v${pkgver}/Noto.zip")
sha256sums=('3258ff3163691cf089cf4c0e4140ec7d564eeb918a7e67786145e94ed124e1e8')

package() {
  cd "$srcdir"

  # Noto.zip bundles Noto Sans, Noto Sans Mono, and Noto Mono families; this
  # package only ships the Noto Sans Mono (NotoSansMNerdFont*) subset, which
  # covers the regular / Mono / Propo subfamilies across all weights.
  install -Dm644 NotoSansMNerdFont*.ttf -t "$pkgdir/usr/share/fonts/TTF/"

  install -Dm644 OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 LICENSE_OFL.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
